# Laravel Dockerfile - PHP 8.4 (Dynamic)
# Supports dynamic PHP extension installation based on composer.json

# ---------------------------------------------------------------------------
# Stage 1: Composer Dependencies and PHP Extension Detection
# ---------------------------------------------------------------------------
FROM composer:2 AS composer
WORKDIR /app
RUN mkdir -p public/build

COPY composer.json composer.lock* ./

# Detect required PHP extensions from composer.json
# Maps common packages (e.g. ext-redis, intervention/image) to their native extensions
RUN cat > detect_extensions.php << 'EOF'
<?php
$composer = json_decode(file_get_contents('composer.json'), true);
$extensions = [];

$package_extensions = [
    'intervention/image'            => ['gd', 'imagick'],
    'league/flysystem-aws-s3-v3'    => ['curl'],
    'pusher/pusher-php-server'      => ['curl'],
    'guzzlehttp/guzzle'             => ['curl'],
    'predis/predis'                 => [],
    'phpredis/phpredis'             => ['redis'],
    'ext-redis'                     => ['redis'],
    'ext-memcached'                 => ['memcached'],
    'ext-imagick'                   => ['imagick'],
    'ext-gmp'                       => ['gmp'],
    'ext-intl'                      => ['intl'],
    'ext-ldap'                      => ['ldap'],
    'ext-soap'                      => ['soap'],
    'ext-sockets'                   => ['sockets'],
    'ext-xmlrpc'                    => ['xmlrpc'],
];

foreach (['require', 'require-dev'] as $section) {
    if (isset($composer[$section])) {
        foreach ($composer[$section] as $package => $version) {
            if (isset($package_extensions[$package])) {
                $extensions = array_merge($extensions, $package_extensions[$package]);
            }
        }
    }
}

$default_extensions = ['pdo_mysql', 'mbstring', 'exif', 'pcntl', 'bcmath', 'gd', 'zip', 'opcache'];
$extensions = array_unique(array_merge($extensions, $default_extensions));
echo implode(' ', $extensions);
EOF

RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs || \
    composer install --no-dev --prefer-dist --ignore-platform-reqs

# Copy only directories needed for autoload class mapping
COPY app/ app/
COPY bootstrap/ bootstrap/
COPY config/ config/
COPY database/ database/
COPY routes/ routes/
COPY public/index.php public/index.php
COPY artisan artisan

RUN composer dump-autoload --optimize --no-dev --classmap-authoritative --no-scripts && \
    php detect_extensions.php > /tmp/required_extensions.txt

# ---------------------------------------------------------------------------
# Stage 2: Frontend Assets
# ---------------------------------------------------------------------------
FROM node:20-alpine AS frontend
WORKDIR /app
RUN mkdir -p public/build

COPY .env* ./
COPY package*.json bun.lock* yarn.lock* pnpm-lock.yaml* ./

# Install bun runtime only when the project uses it
RUN if [ -f bun.lock ]; then \
        apk add --no-cache curl bash unzip libstdc++ && \
        curl -fsSL https://bun.sh/install | bash && \
        cp /root/.bun/bin/bun /usr/local/bin/bun; \
    fi

# Install JS dependencies using the lock file's package manager
RUN if [ -f bun.lock ]; then \
        bun install; \
    elif [ -f package-lock.json ]; then \
        npm ci || npm install; \
    elif [ -f yarn.lock ]; then \
        npm install -g yarn && yarn install; \
    elif [ -f pnpm-lock.yaml ]; then \
        npm install -g pnpm && pnpm install; \
    else \
        npm install; \
    fi

COPY resources/ resources/
COPY public/ public/
COPY vite.config.js* webpack.mix.js* tailwind.config.js* postcss.config.js* ./

# Vendor is needed for Tailwind content scanning and Vite plugin resolution
COPY --from=composer /app/vendor /tmp/vendor
RUN rm -rf /app/vendor && mv /tmp/vendor /app/vendor

# Generate a shell script that detects missing JS dependencies by scanning source files.
# Common Laravel scaffold packages (vue, jquery, bootstrap) are often referenced
# in code but missing from package.json, especially in older projects.
RUN cat > /tmp/detect_missing_deps.sh << 'SCRIPT'
#!/bin/sh
MISSING=""

check_dep() {
    PATTERN=$1
    PACKAGE=$2
    if grep -rq "$PATTERN" resources/js/ 2>/dev/null; then
        if ! node -e "require('$(echo $PACKAGE | cut -d@ -f1)')" 2>/dev/null; then
            MISSING="$MISSING $PACKAGE"
        fi
    fi
}

if [ -d resources/js ]; then
    check_dep "require('vue')\|require(\"vue\")\|from 'vue'\|from \"vue\"" "vue@2"
    check_dep "require('vue')\|require(\"vue\")\|from 'vue'\|from \"vue\"" "vue-template-compiler@2"
    check_dep "require('jquery')\|require(\"jquery\")" "jquery"
    check_dep "require('bootstrap')\|require(\"bootstrap\")" "bootstrap@4"
    check_dep "require('popper.js')\|require(\"popper.js\")" "popper.js"
fi

# Detect sass usage from webpack.mix.js build config
if grep -rq "\.scss\|\.sass\|sass(" webpack.mix.js 2>/dev/null; then
    if ! node -e "require('sass')" 2>/dev/null; then
        MISSING="$MISSING sass sass-loader"
    fi
fi

echo "$MISSING"
SCRIPT

RUN chmod +x /tmp/detect_missing_deps.sh && \
    MISSING_DEPS=$(/tmp/detect_missing_deps.sh) && \
    if [ -n "$MISSING_DEPS" ]; then \
        npm install --save-dev $MISSING_DEPS 2>/dev/null || true; \
    fi

# Build frontend assets. Non-fatal: the PHP backend will still deploy
# even if CSS/JS compilation fails entirely.
# Fallback order: build -> production (Laravel Mix) -> dev
RUN if [ -f package.json ]; then \
        if [ -f bun.lock ]; then \
            bun run build || true; \
        else \
            npm run build || npm run production || npm run dev 2>/dev/null || true; \
        fi; \
    fi

# Vite 5+ stores manifest in a nested directory; copy to expected location
RUN if [ -f public/build/.vite/manifest.json ]; then \
        cp public/build/.vite/manifest.json public/build/manifest.json; \
    fi

RUN mkdir -p /app/public/build

# ---------------------------------------------------------------------------
# Stage 3: Production Runtime
# ---------------------------------------------------------------------------
FROM paas-runtime-php:8.4-alpine

LABEL maintainer="Laravel PaaS"
LABEL description="Laravel with PHP 8.4 (Dynamic Extensions)"

# Install only PHP extensions that are missing from the base runtime image
COPY --from=composer /tmp/required_extensions.txt /tmp/

RUN REQUIRED_EXTS=$(cat /tmp/required_extensions.txt) && \
    MISSING_EXTS="" && \
    for ext in $REQUIRED_EXTS; do \
        if ! php -m | grep -qi "^$ext$"; then \
            MISSING_EXTS="$MISSING_EXTS $ext"; \
        fi \
    done && \
    if [ -n "$MISSING_EXTS" ]; then \
        apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
        && docker-php-ext-install $MISSING_EXTS \
        && apk del .build-deps; \
    fi && \
    rm -rf /var/cache/apk/* /tmp/required_extensions.txt

# PHP production tuning
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.jit_buffer_size=100M'; \
    echo 'opcache.jit=1255'; \
    echo 'memory_limit=256M'; \
    echo 'upload_max_filesize=32M'; \
    echo 'post_max_size=32M'; \
    echo 'max_execution_time=60'; \
    echo 'max_input_vars=3000'; \
} > /usr/local/etc/php/conf.d/optimization.ini

WORKDIR /var/www/html

COPY . .

COPY --from=composer /app/vendor /tmp/vendor
RUN rm -rf /var/www/html/vendor && mv /tmp/vendor /var/www/html/vendor
COPY --from=frontend /app/public/build/ ./public/build/

RUN mkdir -p storage/app/public \
             storage/framework/cache/data \
             storage/framework/sessions \
             storage/framework/views \
             storage/logs \
             bootstrap/cache \
             /var/log/supervisor \
    && rm -rf public/storage \
    && php artisan storage:link --ansi \
    && php artisan package:discover --ansi \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 storage bootstrap/cache

COPY docker/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

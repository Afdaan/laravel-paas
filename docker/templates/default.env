# ==============================================================================
# DEFAULT ENVIRONMENT TEMPLATE
# ==============================================================================
# This file contains the mandatory system variables for projects.
# Placeholders like {{.Variable}} will be replaced by the backend.

APP_NAME="{{.ProjectName}}"
APP_ENV=production
APP_KEY="{{.AppKey}}"
APP_DEBUG=true
APP_URL=https://{{.Subdomain}}.{{.Domain}}

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=paas-mysql
DB_PORT=3306
DB_DATABASE={{.DatabaseName}}
DB_USERNAME={{.DatabaseName}}
DB_PASSWORD={{.DatabasePassword}}
DATABASE_URL="mysql://{{.DatabaseName}}:{{.DatabasePassword}}@paas-mysql:3306/{{.DatabaseName}}"

# Application Settings
LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_DRIVER=file
SESSION_DRIVER=cookie
FILESYSTEM_DISK=local

# Queue Configuration
QUEUE_CONNECTION={{.QueueConnection}}

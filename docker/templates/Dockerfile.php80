# Laravel Dockerfile - PHP 8.0

# Stage 1: Composer Dependencies
FROM composer:2 AS composer
WORKDIR /app

# Copy composer files first for better layer caching
COPY composer.json composer.lock* ./

# Install dependencies without autoloader for faster install
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs || \
    composer install --no-dev --prefer-dist --ignore-platform-reqs

# Copy all application files for composer autoload
COPY . .

# Generate optimized autoloader
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative --no-scripts

# Stage 2: Production (Laravel Runtime)
FROM paas-registry:5000/library/paas-runtime-php:8.0-alpine

LABEL maintainer="Runara"
LABEL description="Laravel 8.x with PHP 8.0 (Pure Laravel - No Frontend Assets)"

WORKDIR /var/www/html

# Copy all application files
COPY . .

# Copy optimized vendor from composer stage
COPY --from=composer /app/vendor /tmp/vendor
RUN rm -rf /var/www/html/vendor && mv /tmp/vendor /var/www/html/vendor
RUN rm -rf /var/www/html/node_modules /var/www/html/tests /var/www/html/.git /var/www/html/detect_extensions.php /root/.npm /root/.bun /root/.cache \
    && find /usr/lib/python* -name "__pycache__" -exec rm -rf {} + \
    && rm -rf /var/cache/apk/* /tmp/* /usr/src/* /usr/share/man /usr/share/doc /usr/share/info /usr/local/include/* /usr/local/lib/*.a
RUN mkdir -p storage/app/public \
             storage/framework/cache/data \
             storage/framework/sessions \
             storage/framework/views \
             storage/logs \
             bootstrap/cache \
             /var/log/supervisor \
    && rm -rf public/storage \
    && php artisan storage:link --ansi \
    && php artisan package:discover --ansi \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 storage bootstrap/cache

# Copy configuration files
COPY docker/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

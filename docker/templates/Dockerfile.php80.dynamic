# Laravel Dockerfile - PHP 8.0 (Dynamic)
# Unified Builder: PHP, Composer, and Node.js combined

# Dynamic build arguments
ARG BUILD_COMMAND=""

# Stage 1: Unified Builder
FROM paas-builder-base:8.0-alpine AS builder
WORKDIR /app
ARG BUILD_COMMAND
RUN mkdir -p public/build

# Copy all files
COPY . .

# Run Composer (excluding dev)
RUN composer install --no-dev --no-scripts --no-autoloader --prefer-dist --ignore-platform-reqs || \
    composer install --no-dev --prefer-dist --ignore-platform-reqs

# Generate optimized autoloader and detect extensions
RUN composer dump-autoload --optimize --no-dev --classmap-authoritative --no-scripts

# Create extension detection script
RUN cat > detect_extensions.php << 'PHP_EOF'
<?php
$composer = json_decode(file_get_contents('composer.json'), true);
$extensions = [];
$package_extensions = [
    'intervention/image' => ['gd', 'imagick'],
    'league/flysystem-aws-s3-v3' => ['curl'],
    'pusher/pusher-php-server' => ['curl'],
    'guzzlehttp/guzzle' => ['curl'],
    'predis/predis' => [],
    'phpredis/phpredis' => ['redis'],
    'ext-redis' => ['redis'],
    'ext-memcached' => ['memcached'],
    'ext-imagick' => ['imagick'],
    'ext-gmp' => ['gmp'],
    'ext-intl' => ['intl'],
    'ext-ldap' => ['ldap'],
    'ext-soap' => ['soap'],
    'ext-sockets' => ['sockets'],
    'ext-xmlrpc' => ['xmlrpc'],
];
foreach (['require', 'require-dev'] as $section) {
    if (isset($composer[$section])) {
        foreach ($composer[$section] as $package => $v) {
            if (isset($package_extensions[$package])) {
                $extensions = array_merge($extensions, $package_extensions[$package]);
            }
        }
    }
}
$default_extensions = ['pdo_mysql', 'mbstring', 'exif', 'pcntl', 'bcmath', 'gd', 'zip', 'opcache'];
$extensions = array_merge($extensions, $default_extensions);
$extensions = array_unique($extensions);
echo implode(' ', $extensions);
PHP_EOF

RUN php detect_extensions.php > /tmp/required_extensions.txt

# 1. Auto-detect package manager and build JS assets
RUN if [ -f package.json ]; then \
        echo "[PROGRESS] Installing JavaScript dependencies..." && \
        if [ -f bun.lock ]; then bun install; \
        elif [ -f pnpm-lock.yaml ]; then pnpm install; \
        elif [ -f yarn.lock ]; then yarn install; \
        elif [ -f package-lock.json ]; then npm ci --no-audit --no-fund; \
        else npm install --no-audit --no-fund; fi && \
        echo "[PROGRESS] Building frontend assets..." && \
        if grep -q '"build":' package.json; then \
            if [ -f bun.lock ]; then bun run build; \
            elif [ -f pnpm-lock.yaml ]; then pnpm build; \
            elif [ -f yarn.lock ]; then yarn build; \
            else npm run build; fi; \
        elif grep -q '"prod":' package.json; then \
            if [ -f bun.lock ]; then bun run prod; \
            elif [ -f pnpm-lock.yaml ]; then pnpm prod; \
            elif [ -f yarn.lock ]; then yarn prod; \
            else npm run prod; fi; \
        elif grep -q '"production":' package.json; then \
            if [ -f bun.lock ]; then bun run production; \
            elif [ -f pnpm-lock.yaml ]; then pnpm production; \
            elif [ -f yarn.lock ]; then yarn production; \
            else npm run production; fi; \
        else \
            echo "[PROGRESS] No build script found in package.json, skipping JS build."; \
        fi \
    fi

# 2. Execute user-defined custom build command
RUN if [ -n "$BUILD_COMMAND" ]; then \
        echo "[PROGRESS] Executing custom build command: $BUILD_COMMAND" && \
        eval "$BUILD_COMMAND"; \
    fi

# Sync Vite 5+ manifest location for Laravel compatibility
RUN if [ -f public/build/.vite/manifest.json ]; then \
        cp public/build/.vite/manifest.json public/build/manifest.json; \
    fi

# Ensure build directory exists
RUN mkdir -p /app/public/build

# Deep cleanup of build-time only artifacts before copying to production stage
RUN rm -rf /app/node_modules \
           /app/.git \
           /app/.github \
           /app/.vscode \
           /app/tests \
           /app/scratch \
           /app/stress-test \
           /app/.npm \
           /app/.yarn \
           /app/.bun \
           /app/.cache \
           /app/detect_extensions.php \
           /root/.npm \
           /root/.bun \
           /root/.cache \
           /root/.yarn \
           /root/.composer

# Stage 2: Production (Optimized Runtime)
FROM paas-runtime-php:8.0-alpine

LABEL maintainer="Laravel PaaS"
LABEL description="Laravel with PHP 8.0 (Dynamic & Fast)"

# Copy extension requirements
COPY --from=builder /tmp/required_extensions.txt /tmp/

# Install ONLY missing extensions
RUN REQUIRED_EXTS=$(cat /tmp/required_extensions.txt) && \
    MISSING_EXTS="" && \
    for ext in $REQUIRED_EXTS; do \
        if ! php -m | grep -qi "$ext"; then \
            MISSING_EXTS="$MISSING_EXTS $ext" && \
            echo "Extension $ext is missing, adding to install list..."; \
        fi \
    done && \
    if [ -n "$MISSING_EXTS" ]; then \
        echo "Installing missing extensions: $MISSING_EXTS" && \
        apk add --no-cache --virtual .build-deps $PHPIZE_DEPS \
        && docker-php-ext-install $MISSING_EXTS \
        && apk del .build-deps; \
    fi && \
    docker-php-source delete && \
    find /usr/local/lib/php/extensions -name "*.so" -exec strip --strip-unneeded {} + 2>/dev/null || true && \
    rm -rf /usr/local/lib/php/doc /usr/local/lib/php/test /usr/local/lib/php/PEAR /usr/local/lib/php/.registry && \
    rm -rf /usr/lib/python*/test /usr/lib/python*/unittest /usr/lib/python*/ensurepip /usr/lib/python*/idlelib /usr/lib/python*/pydoc* /usr/lib/python*/lib2to3 && \
    find /usr/lib/python* -name "__pycache__" -exec rm -rf {} + && \
    rm -rf /var/cache/apk/* /tmp/required_extensions.txt /tmp/* /usr/src/* /usr/share/man /usr/share/doc /usr/share/info /usr/local/include/* /usr/local/lib/*.a

# Optimized PHP configuration
RUN { \
    echo 'opcache.memory_consumption=128'; \
    echo 'opcache.interned_strings_buffer=8'; \
    echo 'opcache.max_accelerated_files=4000'; \
    echo 'opcache.revalidate_freq=0'; \
    echo 'opcache.validate_timestamps=0'; \
    echo 'opcache.fast_shutdown=1'; \
    echo 'opcache.enable_cli=1'; \
    echo 'opcache.jit_buffer_size=100M'; \
    echo 'opcache.jit=1255'; \
    echo 'memory_limit=256M'; \
    echo 'upload_max_filesize=32M'; \
    echo 'post_max_size=32M'; \
    echo 'max_execution_time=60'; \
    echo 'max_input_vars=3000'; \
} > /usr/local/etc/php/conf.d/optimization.ini

WORKDIR /var/www/html

# Copy project files from unified builder
COPY --from=builder --chown=www-data:www-data /app /var/www/html

# Set up directories and permissions
RUN mkdir -p storage/app/public \
             storage/framework/cache/data \
             storage/framework/sessions \
             storage/framework/views \
             storage/logs \
             bootstrap/cache \
             /var/log/supervisor \
    && rm -rf public/storage \
    && php artisan storage:link --ansi \
    && php artisan package:discover --ansi \
    && chmod -R 775 storage bootstrap/cache

# Copy configuration
COPY docker/nginx.conf /etc/nginx/http.d/default.conf
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

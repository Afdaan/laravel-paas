# ===========================================
# Traefik Dynamic Configuration
# ===========================================
# Middleware and static routes
# Auto-generated from template - DO NOT EDIT DIRECTLY
# ===========================================

http:
  # Middlewares
  middlewares:
    # Security headers for all routes
    security-headers:
      headers:
        frameDeny: true
        contentTypeNosniff: true
        permissionsPolicy: "geolocation=(), microphone=(), camera=()"
        referrerPolicy: "strict-origin-when-cross-origin"
        customResponseHeaders:
          X-Powered-By: ""

    # Rate limiting
    rate-limit:
      rateLimit:
        average: 100
        burst: 50

  # Routers for Runara platform
  routers:
    # User projects (highest priority - subdomain matching)
    user-projects:
      rule: "HostRegexp(`^[a-zA-Z0-9-]+\\.{{PROJECT_DOMAIN}}$`)"
      service: dynamic-projects
      entryPoints:
        - web
        - websecure
      priority: 200
      tls: {}
      middlewares:
        - security-headers


    # Backend API (high priority)
    api:
      rule: "Host(`{{BASE_DOMAIN}}`) && PathPrefix(`/api`)"
      service: backend
      entryPoints:
        - web
        - websecure
      priority: 100
      tls: {}
      middlewares:
        - security-headers
        - rate-limit

    # Frontend dashboard (lowest priority)
    frontend:
      rule: "Host(`{{BASE_DOMAIN}}`)"
      service: frontend
      entryPoints:
        - web
        - websecure
      priority: 1
      tls: {}
      middlewares:
        - security-headers



  # Services
  services:
    frontend:
      loadBalancer:
        servers:
          - url: "http://paas-frontend:80"

    backend:
      loadBalancer:
        servers:
          - url: "http://paas-backend:8080"

    # Dynamic service - will route to user containers
    dynamic-projects:
      loadBalancer:
        servers:
          - url: "http://paas-backend:8080/proxy"

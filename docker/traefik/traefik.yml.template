# ===========================================
# Traefik Dev Configuration (Cloudflare Tunnel)
# ===========================================

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    forwardedHeaders:
      trustedIPs:
        - "127.0.0.1/32"
        - "192.168.0.0/16" # Private network range (covers your 192.168.255.x)
        - "172.16.0.0/12" # Docker internal network range
  websecure:
    address: ":443"
    forwardedHeaders:
      trustedIPs:
        - "127.0.0.1/32"
        - "192.168.0.0/16"
        - "172.16.0.0/12"


providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: paas-network
  file:
    directory: /etc/traefik/dynamic
    watch: true
  http:
    endpoint: "http://paas-backend:8080/api/internal/traefik/config"
    headers:
      X-Internal-Token: "__INTERNAL_API_TOKEN__"
    pollInterval: "2s"
    pollTimeout: "5s"

log:
  level: DEBUG


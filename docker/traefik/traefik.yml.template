# ===========================================
# Traefik Dev Configuration (Cloudflare Tunnel)
# ===========================================

api:
  dashboard: true
  insecure: false

entryPoints:
  web:
    address: ":80"
    forwardedHeaders:
      trustedIPs:
__TRAEFIK_TRUSTED_IPS__
  websecure:
    address: ":443"
    forwardedHeaders:
      trustedIPs:
__TRAEFIK_TRUSTED_IPS__


providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: paas-network
  file:
    directory: /etc/traefik/dynamic
    watch: true
  http:
    endpoint: "http://paas-backend:8080/api/internal/traefik/config"
    headers:
      X-Internal-Token: "__INTERNAL_API_TOKEN__"
    pollInterval: "2s"
    pollTimeout: "5s"

log:
  level: DEBUG


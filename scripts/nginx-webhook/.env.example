# Port where the webhook server will listen
PORT=49512

# Shared secret key for webhook authentication (Must match Backend configuration)
WEBHOOK_KEY=change_this_to_a_secure_secret_key

# Admin email for Let's Encrypt SSL certificate notifications
SSL_EMAIL=admin@example.com

# (Optional) Directory where generated Nginx configurations will be saved
# NGINX_CONF_DIR=/etc/nginx/conf.d/paas-hosting

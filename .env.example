# ===========================================
# Laravel PaaS Environment Configuration
# ===========================================

# Application
APP_ENV=production
APP_DEBUG=false

# ===========================================
# Infrastructure Database (PostgreSQL)
# ===========================================
PG_PASSWORD=change_this_pg_password
PG_DATABASE=paas
PG_USER=paas

# ===========================================
# Student Database Configuration (MySQL)
# ===========================================
MYSQL_ROOT_PASSWORD=change_this_secure_password
MYSQL_DATABASE=paas
MYSQL_USER=paas
MYSQL_PASSWORD=change_this_password

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=change_this_to_random_64_char_string
JWT_EXPIRY_HOURS=24

# ===========================================
# Domain Configuration
# ===========================================
# Base domain for student subdomains
# e.g., student projects will be: project-abc.example.com
BASE_DOMAIN=localhost

# Custom Ports (Change if it conflicts with Laravel Herd, Valet, Apache, etc)
HTTP_PORT=80
HTTPS_PORT=443

# Admin email for Let's Encrypt SSL
ACME_EMAIL=admin@example.com

# ===========================================
# Nginx Remote Webhook (VM to VM Sync)
# ===========================================
NGINX_WEBHOOK_ENABLED=false
NGINX_WEBHOOK_URL=http://your-nginx-vm:49512/webhook
NGINX_WEBHOOK_KEY=random_secure_key_here
INTERNAL_IP=10.0.0.5

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# Docker & Storage Paths
# ===========================================
# Path on host for project git clones
PROJECTS_PATH=/app/storage/projects
# Path on host for persistent student data (storage/app)
DATA_PATH=/app/storage/data
TEMPLATES_PATH=/app/docker/templates
DOCKER_NETWORK=paas-network

# ===========================================
# Resource Limits (Defaults)
# ===========================================
DEFAULT_CPU_LIMIT=0.5
DEFAULT_MEMORY_LIMIT=512m
DEFAULT_MAX_PROJECTS=3
DEFAULT_EXPIRY_DAYS=30

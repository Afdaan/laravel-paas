# ==============================================================================
# LARAVEL PAAS - ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this file to configure your local or production environment.
# Copy this to .env and replace placeholders with actual values.

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=Laravel-PaaS
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 64-character random string for JWT_SECRET
JWT_SECRET=placeholder_generate_secure_random_string
JWT_EXPIRY_HOURS=24
UID_SALT=placeholder_generate_secure_random_salt_for_project_urls

# ------------------------------------------------------------------------------
# INFRASTRUCTURE: PRIMARY DATABASE (PostgreSQL)
# Used for storing platform metadata, users, and project records.
# ------------------------------------------------------------------------------
PG_HOST=paas-postgres
PG_PORT=5432
PG_USER=paas
PG_PASSWORD=placeholder_secure_pg_password
PG_DATABASE=paas

# ------------------------------------------------------------------------------
# INFRASTRUCTURE: PROJECT DATABASE (MySQL/MariaDB)
# Root credentials used to manage individual databases for user projects.
# ------------------------------------------------------------------------------
MYSQL_HOST=paas-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=placeholder_secure_mysql_root_password
MYSQL_DATABASE=paas
MYSQL_USER=paas
MYSQL_PASSWORD=placeholder_secure_mysql_user_password

# ------------------------------------------------------------------------------
# CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=paas-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# NETWORKING & DOMAINS
# ------------------------------------------------------------------------------
# The main domain where the dashboard is accessible
BASE_DOMAIN=localhost
# The domain used for user project subdomains (can match BASE_DOMAIN)
PROJECT_DOMAIN=localhost

# Traefik configuration
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com
TRAEFIK_DYNAMIC_DIR=

# ------------------------------------------------------------------------------
# DEPLOYMENT MODE & PATHS
# ------------------------------------------------------------------------------
# APP_MODE: 'local' (run via go run) or 'docker' (run via Dockerfile)
APP_MODE=local

# HOST_ROOT_PATH: The absolute path to this project on your host/VPS.
# Required if APP_MODE=docker for volume mounting.
HOST_ROOT_PATH=.
# HOST_ROOT_PATH=/home/ubuntu/laravel-paas

DOCKER_NETWORK=paas-network

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Remote Nginx Webhook for reverse proxy synchronization
NGINX_WEBHOOK_ENABLED=false
NGINX_WEBHOOK_URL=http://your-nginx-vm:49512/webhook
NGINX_WEBHOOK_KEY=placeholder_secure_webhook_key
INTERNAL_IP=127.0.0.1

# ------------------------------------------------------------------------------
# GITHUB APP INTEGRATION (Smart Git Connect)
# ------------------------------------------------------------------------------
# The App ID of your registered GitHub App
GITHUB_APP_ID=
# Path to the GitHub App private key PEM file (on the worker host or container)
GITHUB_APP_PRIVATE_KEY_PATH=storage/data/keys/github-app.pem
# The Webhook Secret specified in your GitHub App settings for HMAC validation
GITHUB_APP_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# LOCAL REGISTRY FOR BASE IMAGES
# ------------------------------------------------------------------------------
# Port for the local base image registry
REGISTRY_PORT=5000
# Host address to bind the registry (default to 127.0.0.1 for local only)
REGISTRY_HOST=127.0.0.1
# Registry Docker image version
REGISTRY_IMAGE=registry:2

# ==============================================================================
# LARAVEL PAAS - ENVIRONMENT TEMPLATE
# ==============================================================================
# Use this file to configure your local or production environment.
# Copy this to .env and replace placeholders with actual values.

# ------------------------------------------------------------------------------
# CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=Laravel-PaaS
APP_ENV=production
APP_DEBUG=false
APP_PORT=8080

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a secure 64-character random string for JWT_SECRET
JWT_SECRET=placeholder_generate_secure_random_string
JWT_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# INFRASTRUCTURE: PRIMARY DATABASE (PostgreSQL)
# Used for storing platform metadata, users, and project records.
# ------------------------------------------------------------------------------
PG_HOST=paas-postgres
PG_PORT=5432
PG_USER=paas
PG_PASSWORD=placeholder_secure_pg_password
PG_DATABASE=paas

# ------------------------------------------------------------------------------
# INFRASTRUCTURE: STUDENT DATABASE (MySQL/MariaDB)
# Root credentials used to manage individual databases for student projects.
# ------------------------------------------------------------------------------
MYSQL_HOST=paas-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=placeholder_secure_mysql_root_password
MYSQL_DATABASE=paas
MYSQL_USER=paas
MYSQL_PASSWORD=placeholder_secure_mysql_user_password

# ------------------------------------------------------------------------------
# INFRASTRUCTURE: CACHE & QUEUE (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=paas-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# NETWORKING & DOMAINS
# ------------------------------------------------------------------------------
# The main domain where the dashboard is accessible
BASE_DOMAIN=localhost
# The domain used for student project subdomains (can match BASE_DOMAIN)
PROJECT_DOMAIN=localhost

# Traefik configuration
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# DOCKER & FILESYSTEM PATHS
# Paths must be absolute or relative to the project root.
# ------------------------------------------------------------------------------
# Host path for project git clones
PROJECTS_PATH=./storage/projects
# Host path for student app storage persistence
DATA_PATH=./storage/data
# Host path for Redis persistence data
REDIS_DATA_PATH=./storage/redis
# Internal templates for Dockerfile generation
TEMPLATES_PATH=./docker/templates

DOCKER_NETWORK=paas-network

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Remote Nginx Webhook for reverse proxy synchronization
NGINX_WEBHOOK_ENABLED=false
NGINX_WEBHOOK_URL=http://your-nginx-vm:49512/webhook
NGINX_WEBHOOK_KEY=placeholder_secure_webhook_key
INTERNAL_IP=127.0.0.1

:80 {
    root * /app/{{STATIC_DIR}}
    file_server

    # Enable gzip and zstd compression for improved page load speeds
    encode zstd gzip

    # SPA routing fallback for client-side frameworks (React, Vue, Vite, etc.)
    try_files {path} /index.html

    # Leverage browser caching for immutable static assets
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}

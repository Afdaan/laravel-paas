{
  "caches": {
    "npm-cache": {
      "directory": "/root/.npm"
    },
    "yarn-cache": {
      "directory": "/usr/local/share/.cache/yarn"
    },
    "pnpm-store": {
      "directory": "/root/.local/share/pnpm/store"
    }
  },
  "aptPackages": [
    "openssl"
  ],
  "deploy": {
    "base": {
      "image": "node:{{VERSION}}-slim"
    },
    "variables": {
      "NODE_ENV": "production"
    }
  }
}

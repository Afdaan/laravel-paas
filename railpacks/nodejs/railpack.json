{
  "caches": {
    "npm-cache": {
      "directory": "/root/.npm"
    },
    "yarn-cache": {
      "directory": "/usr/local/share/.cache/yarn"
    },
    "pnpm-store": {
      "directory": "/root/.local/share/pnpm/store"
    },
    "tsc-cache": {
      "directory": ".tsbuildinfo",
      "type": "cache"
    }
  },
  "steps": {
    "install": {
      "commands": []
    },
    "build": {
      "commands": []
    }
  },
  "deploy": {
    "base": {
      "image": "node:{{VERSION}}-slim"
    },
    "aptPackages": [
      "openssl"
    ],
    "variables": {
      "NODE_ENV": "production"
    }
  }
}

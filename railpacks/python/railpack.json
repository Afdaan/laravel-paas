{
  "caches": {
    "uv-cache": {
      "directory": "/root/.cache/uv"
    }
  },
  "steps": {
    "install": {
      "commands": [
        "pip install uv",
        "python -m venv /app/.venv",
        "if [ -f requirements.txt ]; then /app/.venv/bin/uv pip install -r requirements.txt; fi",
        "if [ -f pyproject.toml ]; then /app/.venv/bin/uv pip install .; fi"
      ]
    }
  },
  "deploy": {
    "base": {
      "image": "python:{{VERSION}}-slim"
    },
    "variables": {
      "PYTHONUNBUFFERED": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PATH": "/app/.venv/bin:$PATH"
    }
  }
}
